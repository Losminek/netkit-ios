    "speed.warning.ndt7": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "M-Lab uchovává a veřejně zveřejňuje výsledky včetně vaší veřejné IP adresy. Měření může přenést stovky MB až jednotky GB a na mobilním nebo měřeném připojení zvýšit náklady."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "M-Lab stores and publicly publishes results including your public IP address. Measurement may transfer hundreds of MB to several GB and incur charges on cellular or metered connections."
          }
        }
      }
    },
    "speed.warning.data": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Měření může přenést stovky MB až jednotky GB. Na mobilním nebo měřeném připojení může spotřebovat datový limit a zvýšit náklady."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measurement may transfer hundreds of MB to several GB. On cellular or metered connections it may use your data allowance and incur charges."
          }
        }
      }
    },
    "speed.privacy_link": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zásady soukromí M-Lab"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "M-Lab privacy policy"
          }
        }
      }
    },
    "network.waiting": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čeká se na síť nebo oprávnění k místní síti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for network connectivity or local network permission."
          }
        }
      }
    },
    "speed.ndt_method": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stahování se počítá v aplikaci po náběhu; odesílání měří server za celý test. Výsledky proto používají odlišná měřicí období."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download is calculated in the app after warm-up; upload is measured by the server over the whole test. The results therefore use different measurement periods."
          }
        }
      }
    },
    "wol.warning": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používejte pouze zařízení a sítě, pro něž máte svolení. Podporován je unicast ve stejné Wi-Fi podsíti."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use only devices and networks you are authorized to access. Unicast within the same Wi-Fi subnet is supported."
          }
        }
      }
    },
